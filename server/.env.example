# 金蝶云星空 API 连接配置
KD_SERVER_URL=http://your-kingdee-server:port
KD_DBID=your-db-id
KD_APP_KEY=your-app-key
KD_APP_SECRET=your-app-secret
KD_USERNAME=your-integration-username
KD_PASSWORD=your-integration-password

# 数据起始日期（只拉取此日期之后的单据）
DATA_START_DATE=2026-01-01

# 服务端口
PORT=4000

# 缓存过期时间（秒，默认 300 = 5 分钟）
CACHE_TTL=300

# 钉钉自定义机器人（群机器人 webhook + 加签密钥；未配置则不推送）
ROBOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token
ROBOT_SECRET=你的加签密钥

# 生产执行日报推送 cron 时间（默认每天 8:00 推前一天）
REPORT_PUSH_CRON=0 8 * * *

# ==== 钉钉身份登录（访问 /monitor/ 需先登录）====
# 复用同机 /problem/ 那个企业内部应用；两个值都配上才会启用钉钉登录。
DINGTALK_APP_KEY=你的AppKey
DINGTALK_APP_SECRET=你的AppSecret
# 裸域名，不带 /monitor（回调挂在 /api/monitor/auth/dingtalk-callback）
PUBLIC_BASE_URL=https://k3-aitable.xyz
# 会话有效期（天）
AUTH_SESSION_DAYS=30
# 截图管线的兜底令牌（openssl rand -hex 32 生成）；留空则该通路关闭
AUTH_BYPASS_TOKEN=
# 网关模式：auto（默认：配了凭据走钉钉、没配走旧的 UA/Referer 判断）
#           legacy（强制走旧判断） / off（应急：完全不拦，启动会大声告警）
# AUTH_GATE_MODE=auto

# ==== 人员模块 ====
# 岗位 / 技能等级的下拉选项（逗号分隔）。不配则用代码默认值：配料,灌装,灭菌,外包 / 1级~6级
# STAFF_POSITIONS=配料,灌装,灭菌,外包
# STAFF_SKILL_LEVELS=1级,2级,3级,4级,5级,6级

# ==== 人员名单：钉钉通讯录同步 ====
# 复用上面的 DINGTALK_APP_KEY / DINGTALK_APP_SECRET。
# 只同步这两个部门及其子部门；不存手机号。
DINGTALK_STAFF_SYNC_ENABLED=true
DINGTALK_STAFF_INNER_DEPT=663751617   # 生产部（内包）
DINGTALK_STAFF_OUTER_DEPT=665374465   # 生产部（外包）
DINGTALK_STAFF_SYNC_CRON=30 7 * * *
